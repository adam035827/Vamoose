# Copy to .env (gitignored) or export in your shell. The service reads process env vars only.
AWS_REGION=us-east-2
# Leave blank to use the Strands SDK default Claude model on Bedrock.
VAMOOSE_PLANNER_MODEL_ID=
# 1 = return a canned Lisbon draft without calling Bedrock.
VAMOOSE_MOCK_AGENTS=1
# 1 = run tests marked `live` against real Bedrock.
VAMOOSE_LIVE_TESTS=0
