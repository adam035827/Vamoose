# Copy to Vamoose.Agents/.env (gitignored); the agent loads it at startup. Real environment variables win.
AWS_REGION=us-east-2
# Model roles. Defaults are pinned in vamoose_agents/config.py; set these only to override.
# VAMOOSE_PLANNER_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# VAMOOSE_FAST_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Web search through Tavily's MCP server; without it the agent falls back to DuckDuckGo. Never commit a real key.
TAVILY_API_KEY=
# Or read the key from an AWS Parameter Store SecureString (used on the demo server).
# VAMOOSE_TAVILY_PARAMETER=/vamoose/tavily-api-key
# 1 = trust the OS certificate store for Tavily (needed behind TLS inspection such as Zscaler).
VAMOOSE_USE_OS_TRUSTSTORE=0
# 1 = return canned responses without calling Bedrock.
VAMOOSE_MOCK_AGENTS=1
# 1 = run tests marked `live` against real Bedrock.
VAMOOSE_LIVE_TESTS=0
